{
  "name": "pcb-viewer",
  "version": "1.68.0",
  "private": true,
  "description": "Browser-based interactive PCB viewer for KiCad and Gerber files, with 3D and TOP/BOTTOM views and simple IR-drop, signal integrity, thermal and circuit simulations.",
  "type": "module",
  "optionalDependencies": {
    "@github/copilot-sdk": "^1.0.24"
  },
  "scripts": {
    "build": "node scripts/dsdb.mjs && node scripts/build.mjs",
    "dsdb": "node scripts/dsdb.mjs",
    "dsdb:init": "node scripts/dsdb.mjs --init",
    "test": "node --test test/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:copilot": "node scripts/serve.mjs --copilot",
    "examples": "node scripts/examples.mjs",
    "datasheets": "node scripts/datasheets.mjs",
    "datasheets:download": "node scripts/datasheets.mjs --download"
  },
  "engines": {
    "node": ">=18"
  }
}
