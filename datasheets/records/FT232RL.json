      ],
      [
       "보레이트",
       "183.1 baud ~ 3 Mbaud"
      ],
      [
       "버퍼",
       "RX FIFO 128 바이트, TX FIFO 256 바이트"
      ],
      [
       "내장 기능",
       "1024-bit EEPROM, 12 MHz 내부 발진기(×4 → 48 MHz, 외부 크리스털 불필요), CBUS0 ~ 4 구성 가능 핀"
      ],
      [
       "공급 전압",
       "VCC 4.0 ~ 5.25 V (내부 발진), 3.3 ~ 5.25 V (외부 발진) · VCCIO 1.8 ~ 5.25 V"
      ],
      [
       "LDO 출력",
       "3V3OUT 3.0 ~ 3.6 V, 외부 부하 최대 50 mA"
      ],
      [
       "소비 전류",
       "동작 15 mA typ, USB 서스펜드 70 µA typ"
      ],
      [
       "품질 등급",
       "데이터시트에 AEC-Q100 언급 없음 (산업용)"
      ],
      [
       "온도",
       "−40 ~ +85 °C"
      ],
      [
       "패키지",
       "FT232RL: 28-SSOP (FT232RQ: 32-QFN)"
      ]
     ]
    }
