   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "CPU",
       "ARM Cortex-R4F 듀얼 락스텝, 단·배정밀 FPU, 12영역 MPU, 1.66 DMIPS/MHz"
      ],
      [
       "클럭",
       "HCLK 최대: ZWT 180 MHz / PGE 160 MHz (플래시 파이프라인 모드), 파이프라인 해제 시 50 MHz. VCLK 최대 100 MHz"
      ],
      [
       "메모리",
       "플래시 3 MB (ECC), RAM 256 KB (ECC), 데이터 플래시(EEPROM 에뮬레이션) 64 KB (ECC)"
      ],
      [
       "네트워크",
       "EMAC 10/100 (MII/RMII/MDIO, 3.3 V I/O), FlexRay 2채널 10 Mbps (8 KB 메시지 RAM), DCAN ×3 (64 메일박스)"
      ],
      [
       "기타 통신",
       "MibSPI ×3, SPI ×2, SCI ×1 + LIN ×1, I2C ×1, 16비트 EMIF"
      ],
      [
       "아날로그·타이머",
       "12비트 MibADC ×2 (ADC1 24채널, ADC2 16채널 공유), N2HET ×2 (32 + 18채널)"
      ],
      [
       "안전",
       "락스텝 CPU, CPU·RAM BIST, 플래시·RAM ECC, 주변 메모리 패리티, ESM(ERROR 핀), 전압·클럭 감시, 듀얼 클럭 비교기"
      ],
      [
       "전원",
       "코어 1.2 V, I/O 3.3 V, ADC 3.0 ~ 5.25 V"
      ],
      [
       "온도",
       "TA -40 ~ 125 °C, TJ -40 ~ 150 °C"
      ],
      [
       "패키지",
       "144핀 LQFP (PGE, 20 × 20 mm), 337볼 NFBGA (ZWT, 16 × 16 mm)"
      ]
     ]
    }
   ]
