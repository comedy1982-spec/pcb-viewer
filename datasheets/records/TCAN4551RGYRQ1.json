      [
       "기능",
       "SPI 접속 CAN FD 컨트롤러(Bosch M_CAN rev 3.2.1.1, ISO 11898-1:2015) + ISO 11898-2:2016 트랜시버 통합. INH, WAKE 포함"
      ],
      [
       "데이터율 · SPI",
       "CAN FD 최대 8 Mbps, SPI 클록 최대 18 MHz, Classic CAN 호환"
      ],
      [
       "전원",
       "VSUP 5.5 ~ 30 V (권장), VIO 1.71 ~ 5.25 V (1.8 V 및 3.3 ~ 5 V 로직)"
      ],
      [
       "내부 레귤레이터",
       "VCCFLTR = 내부 5 V 트랜시버 레귤레이터 필터 핀 (10 µF), 외부 부하용 출력 아님"
      ],
      [
       "모드",
       "Normal, Standby, Sleep, Failsafe"
      ],
      [
       "버스 보호",
       "±58 V 버스 폴트, ±12 V 공통 모드, 무전원 시 버스·로직 고임피던스"
      ],
      [
       "등급 · 온도",
       "AEC-Q100 Grade 1, TA -40 ~ 125 °C"
      ],
      [
       "패키지",
       "VQFN-20 (RGY), 열 패드"
      ]
     ]
    }
