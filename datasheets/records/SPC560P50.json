 "sections": [
  {
   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "코어",
       "32비트 e200z0h (Power Architecture, VLE), 최대 64 MHz"
      ],
      [
       "메모리",
       "코드 플래시 최대 512 KB (ECC) · 데이터 플래시 64 KB (4 × 16 KB, ECC, EEPROM 에뮬레이션) · SRAM 최대 40 KB (ECC)"
      ],
      [
       "모터 제어",
       "FlexPWM 1개 (8출력) · eTimer 2개 (각 16비트 6채널) · 10비트 ADC 2개 (2 × 11채널 + 공유 4, 변환 &lt; 1 µs)"
      ],
      [
       "통신",
       "FlexCAN 1 (2.0B, 메시지 객체 32) + FlexCAN 기반 Safety port 1 (최대 7.5 Mbit/s) · FlexRay V2.1 1 (최대 10 Mbit/s, 512 KB 품목만) · LINFlex 2 · DSPI 4"
      ],
      [
       "안전·기타",
       "워치독, NMI, Fault Collection Unit, eDMA 16채널, Nexus L2+, CAN/UART 부트로더"
      ],
      [
       "전원",
       "3.3 V 또는 5.0 V 단일 공급 (I/O 3.0–3.6 V / 4.5–5.5 V, 레귤레이터 3.0–5.5 V / 4.5–5.5 V) + 외부 NPN 밸러스트로 코어 1.2 V 생성"
      ],
      [
       "온도",
       "TA −40 ~ 105 °C (fCPU 64 MHz), −40 ~ 125 °C (fCPU 60 MHz) · Tj 최대 150 °C"
      ],
      [
       "패키지",
       "SPC560P50L3: LQFP100 14 × 14 × 1.4 mm · SPC560P50L5: LQFP144 20 × 20 × 1.4 mm"
      ],
      [
       "수명",
       "Active, 2034-01까지 공급 (일부 주문 코드 NRND)"
      ]
     ]
    }
   ]
