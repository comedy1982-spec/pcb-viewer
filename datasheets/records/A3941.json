     "dl": [
      [
       "기능",
       "하이사이드 2 + 로우사이드 2 게이트 구동, 브러시 DC 모터 등 유도성 부하용"
      ],
      [
       "전원 VBB",
       "5.5~50 V 단일 비안정 전원 (7 V부터 완전 사양, 5.5 V까지 게이트 구동 감소)"
      ],
      [
       "게이트 구동",
       "배터리 7 V까지 10 V 이상, 차지펌프로 VREG 약 13 V 생성"
      ],
      [
       "하이사이드",
       "부트스트랩 커패시터 + 내부 톱오프 차지펌프로 100% 듀티 가능"
      ],
      [
       "데드타임",
       "RDEAD 저항으로 설정, 교차 도통 보호"
      ],
      [
       "로직 전원",
       "내장 5 V 레귤레이터 (V5)"
      ],
      [
       "진단",
       "FF1/FF2 폴트 플래그: 저전압, 과온, 단락 (VDS 모니터, 임계 VDSTH)"
      ],
      [
       "모드",
       "고속/저속 감쇠, 다이오드 또는 동기 정류, 저전류 슬립"
      ],
      [
       "온도",
       "K 범위 TA -40~150 °C"
      ],
      [
       "패키지",
       "A3941KLPTR-T: 28-pin TSSOP, 노출 열패드 (LP), 릴당 4000개"
      ]
     ]
    }
   ]
