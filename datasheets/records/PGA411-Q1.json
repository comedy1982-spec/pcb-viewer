 "sections": [
  {
   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "기능",
       "리졸버 센서 인터페이스: AFE + RDC(10/12-bit) + 여자(exciter) 앰프 + 부스트 DC-DC, 센서 입력 고장 진단, 아날로그/로직 BIST, 자동/수동 위상 보정 (SafeTI)"
      ],
      [
       "전원",
       "VCC/QVCC 5 V ±5 %, VIO 3.3 V 또는 5 V, VCCSW(부스트 입력) 4.75–8.5 V, VEXT 12 V (4 Vrms 모드) / 15 V (7 Vrms 모드)"
      ],
      [
       "여자 출력",
       "10–20 kHz, 차동 7.12–13.85 Vpp (4 Vrms) / 12.49–24.27 Vpp (7 Vrms), 최대 145 mA"
      ],
      [
       "정확도 / 추종",
       "±10.56 / ±2.64 arcmin (10/12-bit), 추종 200,000 / 72,000 rpm, 180° 정착 1.5 ms"
      ],
      [
       "인터페이스",
       "SPI (최대 8 MHz @ VIO 3.3 V), 병렬 ORD0–ORD11, 인크리멘털 엔코더 A/B/Z, U/V/W 출력, FAULT 오픈드레인"
      ],
      [
       "클럭",
       "내부 20 MHz (18.4–21.6 MHz) 또는 외부 크리스털 (XIN/XOUT)"
      ],
      [
       "등급",
       "AEC-Q100 Grade 1 (TA −40 ~ 125 °C), HBM 레벨 2, CDM C4B"
      ],
      [
       "패키지",
       "HTQFP-64 (PAP) 10 × 10 mm, 0.5 mm 피치, PowerPAD — 주문 PGA411QPAPRQ1"
      ]
     ]
    }
   ]
  },
