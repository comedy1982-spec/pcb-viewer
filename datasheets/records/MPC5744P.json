    {
     "dl": [
      [
       "코어",
       "e200z4 2개 지연 락스텝, 0–200 MHz (+2 % FM), ISO 26262 ASIL D (SafeAssure)"
      ],
      [
       "메모리",
       "코드/데이터 플래시 2.5 MB (ECC, RWW), SRAM 384 KB (ECC)"
      ],
      [
       "통신",
       "FlexRay 1 (64 MB, 듀얼 채널), FlexCAN 3 (각 64 MB), LINFlexD 2, DSPI 4, Ethernet 1, SENT 2 (각 2ch)"
      ],
      [
       "아날로그·타이머",
       "12-bit SAR ADC 4개 (각 16ch), CTU 2, FlexPWM 2 (4×(2+1)ch), eTimer 3 (6ch), eDMA 32ch"
      ],
      [
       "클록",
       "16 MHz 내부 RC, 외부 크리스털 8–40 MHz, PLL + FMPLL"
      ],
      [
       "전원",
       "3.3 V 단일 공급 (VDD_HV_* 3.15–3.6 V) + 코어 1.25 V (VDD_LV 1.19–1.32 V, 외부 NPN 밸러스트 또는 외부 LDO); ADC 기준 VDD_HV_ADRE 3.15–5.5 V"
      ],
      [
       "온도",
       "Tj -40~150 °C (165 °C는 마킹 품목, 누적 200 h 제한), TA -40~125 °C (K 코드 135 °C)"
      ],
      [
       "ESD",
       "HBM 2000 V (H1C), CDM 500 V / 코너 750 V (C3A) — AEC-Q100-002/-011"
      ],
      [
       "패키지",
       "144 LQFP (20×20 mm, 0.5 mm 피치, SOT486-2), 257 MAPBGA (14×14 mm, 0.8 mm 피치)"
      ],
      [
       "이 품번",
       "SP5744PFK1AMLQ9R: 2.5 MB / 384 KB, LQFP-144 (NXP SOT486-2), F = FlexRay (이더넷 없음), K1 마스크, M = -40~125 °C, LQ = 144 LQFP, 9 = 200 MHz, R = 테이프·릴 (배포처: -40~125 °C, Active, 릴 500개)"
      ]
     ]
    }
   ]
