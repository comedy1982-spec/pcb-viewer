      [
       "기능",
       "외부 N-MOSFET 6개용 3상 하프브리지 게이트 드라이버(부트스트랩, 100 % 듀티 지원) + 벅 컨버터 + 전류 션트 앰프 ×2"
      ],
      [
       "PVDD1 (드라이버)",
       "8–60 V (절대 최대 65 V)"
      ],
      [
       "PVDD2 (벅)",
       "3.5–60 V, 출력 최대 1.5 A, 전류 제한 1.8 A min / 2.7 A typ"
      ],
      [
       "게이트 구동",
       "피크 소스 1.7 A / 싱크 2.3 A typ, VGS 9.5–11.5 V"
      ],
      [
       "전류 센스 앰프",
       "이득 10 V/V(GAIN=0 V) 또는 40 V/V, 출력 바이어스 = REF/2, 선형 출력 0.3–5.7 V"
      ],
      [
       "데드타임",
       "DTC 저항(0–150 kΩ)으로 50–500 ns"
      ],
      [
       "보호",
       "VDS 과전류(0.125–2.4 V, OC_ADJ로 설정), PVDD/GVDD UVLO, GVDD OVLO, 과열 경고 130 °C / 차단 150 °C → nFAULT, nOCTW"
      ],
      [
       "스위칭 주파수",
       "최대 200 kHz (Qg 25 nC 기준)"
      ],
      [
       "등급·온도",
       "상용 등급 (AEC-Q100 표기 없음) · TA −40 ~ 125 °C"
      ],
      [
       "패키지",
       "HTSSOP-56 (DCA) 14.00 × 6.10 mm, PowerPAD = GND"
      ]
     ]
    }
   ]
