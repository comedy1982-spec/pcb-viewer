      [
       "기능",
       "외부 N-MOSFET 4개 H-브리지 게이트 드라이버, 100 % 듀티 지원. E = PH/EN 인터페이스 (P = IN1/IN2)"
      ],
      [
       "VM",
       "5.9–45 V (절대 최대 47 V)"
      ],
      [
       "게이트 구동",
       "IDRIVE 핀으로 5단계: 소스/싱크 6/12.5 ~ 150/300 mA · VGS 8.5–10.5 V (VM &gt; 12 V)"
      ],
      [
       "전류 레귤레이션",
       "고정 오프 타임 PWM 초핑, tOFF 25 µs, tBLANK 2 µs, I<sub>TRIP</sub> = (VREF − VOFF)/(AV × R<sub>SENSE</sub>)"
      ],
      [
       "션트 앰프",
       "AV 20 V/V (18–22 V/V @ 50–200 mV), 출력 오프셋 50–250 mV"
      ],
      [
       "LDO",
       "AVDD 4.8 V, DVDD 3.3 V, 각 외부 부하 30 mA까지"
      ],
      [
       "보호",
       "VM UVLO (하강 5.4–5.8 V), 차지 펌프 UV, VDS·SP 과전류 (0.8–1 V, 데글리치 4.5 µs, 재시도 3 ms), 프리드라이버 고장, TSD 150 °C → nFAULT"
      ],
      [
       "슬립 전류",
       "9 µA typ (25 °C, VM 24 V)"
      ],
      [
       "등급·온도",
       "상용 (-Q1 없음) · TA −40 ~ 125 °C · 주문 상태 Active"
      ],
      [
       "패키지",
       "VQFN-24 (RGE) 4.0 × 4.0 × 0.9 mm, PowerPAD = GND"
      ]
     ]
    }
   ]
