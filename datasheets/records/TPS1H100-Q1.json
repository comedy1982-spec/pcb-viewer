      ],
      [
       "동작 전압",
       "공칭 5 ~ 40 V, 확장 3.5 ~ 5 V (RDS(on) 최대 20% 증가)"
      ],
      [
       "RDS(on)",
       "25 °C 일반 80 mΩ / 최대 100 mΩ, 150 °C 최대 166 mΩ, VS = 3.5 V에서 최대 120 mΩ"
      ],
      [
       "부하 전류",
       "공칭 DC 0 ~ 4 A"
      ],
      [
       "전류 제한",
       "내부 7 ~ 13 A, 외부 저항으로 낮게 설정 가능(KCL = 2000, VCL,th 1.233 V, 0.5 A 이상에서 ±20%)"
      ],
      [
       "전류 센스 (B)",
       "K = 500, 정확도 1 A 이상 ±3%, 0.1 A 이상 ±5%, CS 선형 범위 0 ~ 4 V"
      ],
      [
       "대기 전류",
       "최대 0.5 µA (25 °C, VS = 13.5 V)"
      ],
      [
