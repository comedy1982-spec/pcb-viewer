   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "기능",
       "ISO 11898-2 호환 CAN 트랜시버, 3.3 V 단일 전원, 5 V CAN 노드와 상호 운용"
      ],
      [
       "전원",
       "VCC 3 ~ 3.6 V, 공급 전류 10 mA typ (17 mA max, 무부하)"
      ],
      [
       "속도",
       "최대 1 Mbps, 루프 지연 70–115 ns (Rs = 0)"
      ],
      [
       "모드 (RS 핀)",
       "고속 (RS → GND), 슬로프 제어 (10–100 kΩ → GND), 스탠바이/리슨 온리 (RS ≥ 0.75 VCC, 370 µA typ)"
      ],
      [
       "버스",
       "VOD(D) 1.5–3 V @ 60 Ω, 차동 입력 저항 40 kΩ min → 최대 120 노드, 버스 핀 절대 최대 −4 ~ 16 V"
      ],
      [
       "ESD",
       "HBM ±16 kV (CANH, CANL, GND), 전체 핀 ±4 kV, CDM ±1 kV"
      ],
      [
       "온도",
       "TA −40 ~ 85 °C (산업용, AEC-Q100 아님)"
      ],
      [
       "패키지",
       "SOIC-8 (D), 테이프&amp;릴 (R)"
      ]
     ]
    }
   ]
  },
