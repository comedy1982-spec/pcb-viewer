        "4.7 µF 0603 × 1 + 0.1 µF × 1"
       ],
       [
        "VDDA18",
        "0.1 µF × 2"
       ],
       [
        "VDDA18_OSC_PLL",
        "LC 필터: 페라이트 비드 (BLM18EG121SN1D) + 0.1 µF"
       ],
       [
        "VDDS33",
