      [
       "기능",
       "저전력 CAN / CAN FD 트랜시버, INH 출력(레귤레이터 제어), WAKE 로컬 웨이크, nFAULT, Normal/Silent/Standby/Sleep 모드"
      ],
      [
       "데이터율",
       "<b>2 Mbps</b> (H 버전). 5 Mbps 는 G / HG 버전"
      ],
      [
       "버스 보호",
       "CANH/CANL ±70 V (H 버전, 표준 ±58 V)"
      ],
      [
       "전원",
       "VSUP 4.5 ~ 60 V (H), VCC 4.5 ~ 5.5 V, VIO 2.8 ~ 5.5 V"
      ],
      [
       "대기 전류",
       "VSUP Sleep 15–30 µA, Standby 15–45 µA; VCC Standby/Sleep 5 µA"
      ],
      [
       "타이밍",
       "루프 지연 100–160 ns (R→D) / 110–175 ns (D→R), TXD 도미넌트 타임아웃 1.2–3.8 ms (최저 9.2 kbps)"
      ],
      [
       "등급",
       "AEC-Q100, TA −55 ~ 125 °C, TJ −55 ~ 150 °C"
      ],
      [
       "패키지",
       "SOIC-14 (D) 8.65 × 6 mm, 테이프&amp;릴"
      ]
     ]
    }
