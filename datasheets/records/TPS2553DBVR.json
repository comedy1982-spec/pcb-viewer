    {
     "dl": [
      [
       "기능",
       "N채널 하이사이드 전원 스위치, 외부 RILIM으로 정전류 제한, 역전압 보호, FAULT 플래그"
      ],
      [
       "입력 전압",
       "2.5 ~ 6.5 V"
      ],
      [
       "연속 출력 전류",
       "최대 1.5 A (TJ ≤ 105 °C), 1.2 A (TJ ≤ 125 °C)"
      ],
      [
       "전류 제한",
       "75 mA ~ 1.7 A 설정, RILIM 15 ~ 232 kΩ (20 kΩ → 1295 mA, 49.9 kΩ → 520 mA 일반)"
      ],
      [
       "rDS(on) (DBV)",
       "일반 85 mΩ, 최대 95 mΩ (25 °C), 최대 135 mΩ (-40 ~ 125 °C)"
      ],
      [
       "소비 전류",
       "동작 120 µA (RILIM 20 kΩ), 차단 0.1 µA 일반 / 1 µA 최대"
      ],
      [
       "FAULT 디글리치",
       "과전류 5 / 7.5 / 10 ms, 역전압 2 / 4 / 6 ms"
      ],
      [
       "ESD",
       "HBM ±2 kV, CDM ±500 V, IEC 61000-4-2 접촉 ±8 kV / 기중 ±15 kV"
      ],
      [
       "온도",
       "TJ -40 ~ 125 °C (상용 등급, AEC-Q100 아님)"
      ],
      [
       "패키지",
       "SOT-23-6 (DBV), 마킹 2553"
      ]
     ]
    }
   ]
  },
