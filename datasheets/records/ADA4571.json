 "sections": [
  {
   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "기능",
       "AMR 브리지 + 계측 증폭기(G = 40), 비례식 아날로그 VSIN/VCOS 출력, 온도 출력 VTEMP, 이득 제어(GC) 모드"
      ],
      [
       "측정 범위",
       "0 ~ 180° (자석 1회전에 출력 2주기, 각도 = arctan2(VSIN, VCOS)/2)"
      ],
      [
       "전원",
       "2.7 ~ 5.5 V, 정지 전류 일반 4.5 mA (WH 최대 6.5 mA, GC = VDD 최대 7 mA)"
      ],
      [
       "각도 오차",
       "WH: 보정 전 ±5°, 1점 보정 후 ±0.7° (-40~150 °C), 동적 일반 0.1° / 최대 ±0.5°"
      ],
      [
       "대역폭",
       "100 kHz (-3 dB), 30,000 rpm에서 지연 2 µs / 위상 오차 0.8°"
      ],
      [
       "출력 범위",
       "7 ~ 93 % VDD"
      ],
      [
       "자기장",
       "최소 25 kA/m (x-y 평면), 최대 회전 50,000 rpm"
      ],
      [
       "온도 · 등급",
       "ADA4571WH -40 ~ +150 °C ('Qualified for Automotive Applications', AEC-Q100 문구는 문서에 없음), ADA4571B -40 ~ +125 °C"
      ],
      [
       "패키지",
       "8-lead SOIC_N (R-8)"
      ]
     ]
    }
   ]
