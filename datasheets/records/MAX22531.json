       "최대 10 MHz"
      ],
      [
       "온도",
       "-40 ~ +125 °C (AEC-Q100 표기 없음)"
      ],
      [
       "패키지",
       "20-pin SSOP, 연면·공간 거리 5.5 mm. 주문 번호 MAX22531AAP+"
      ]
     ]
