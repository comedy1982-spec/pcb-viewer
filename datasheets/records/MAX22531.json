       "기능",
       "필드측 4채널 12비트 SAR ADC + 절연 SPI + 필드측 전원용 절연 DC-DC 내장, 채널 1·2 디지털 비교기 출력(COUT1/2)"
      ],
      [
       "입력",
       "0 ~ 1.8 V (AGND 기준), 내부 기준 1.8 V"
      ],
      [
       "샘플링",
       "채널당 일반 20 ksps (18 ~ 22 ksps)"
      ],
      [
       "정확도",
       "이득 오차 ±0.2 %FS, 오프셋 ±0.1 %FS, INL ±2.0 LSB, DNL ±1.5 LSB"
      ],
      [
       "절연",
       "VISO 3750 V rms (절연 표) / 주문 표 3500 V rms, VIORM 630 V peak, CMTI 일반 50 kV/µs"
      ],
      [
       "전원",
       "VDDL 1.71 ~ 5.5 V (일반 1 mA), VDDPL 3.0 ~ 5.5 V (3.3 V에서 일반 7 mA)"
      ],
      [
