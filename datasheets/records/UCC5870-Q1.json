   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "기능",
       "트랙션 인버터용 단채널 절연 게이트 드라이버, 분리 출력 OUTH/OUTL, 능동 밀러 클램프(내부 또는 외부 구동)"
      ],
      [
       "구동 전류",
       "피크 30 A 소스/싱크 (일반), 구동 세기 16.7 / 33 / 100 % 선택. 외부 게이트 저항으로 15 A 이하로 제한"
      ],
      [
       "전원",
       "VCC1 3–5.5 V, VCC2 15–30 V, VEE2 −12–0 V"
      ],
      [
       "절연",
       "VISO 3750 VRMS 1분 (UL 1577, 인증 예정 표기), CMTI 최소 100 kV/µs, 연면·공간거리 8 mm"
      ],
      [
       "보호",
       "DESAT (2.25–11 V, 16단계), 션트 OC (170–998 mV) / SC (460–1312 mV), NTC 과온, 소프트 턴오프·2단 턴오프, 1차/2차 ASC, 데드타임 관통 방지, VCC1/VCC2/VEE2 UVLO·OVLO"
      ],
      [
       "진단",
       "BIST, 게이트 경로 감시, nFLT1(고장) / nFLT2(경고), 10비트 ADC 6채널 (AI1–AI6, 0–3.6 V), ISO 26262 ASIL D 지원 문서"
      ],
      [
       "인터페이스",
       "SPI 최대 4 MHz, PWM IN+/IN− 최대 50 kHz, 최소 펄스 250 ns"
      ],
      [
       "타이밍",
       "전파 지연 최대 150 ns (0.1 nF, 글리치 필터 off), 상승/하강 150 ns (10 nF)"
      ],
      [
       "등급 / 온도",
       "AEC-Q100 Grade 0 (TA −40 ~ 125 °C), TJ −40 ~ 150 °C"
      ],
      [
       "패키지",
       "DWJ 36핀 SSOP/SOIC, 12.8 × 7.5 mm"
      ]
     ]
    }
   ]
