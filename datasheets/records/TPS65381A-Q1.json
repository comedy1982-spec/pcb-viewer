  {
   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "기능",
       "안전 관련 MCU(락스텝 듀얼코어 등)용 다중 레일 PMIC: VDD6 비동기 벅 프리레귤레이터, VDD5(CAN) LDO, VDD3/5(MCU I/O) LDO, VDD1 코어 LDO 컨트롤러(외부 FET), VSOUT1 트래킹 센서 전원, 차지펌프, 워치독, MCU 에러 핀 감시(ESM), 전압 감시, ABIST/LBIST, SPI, 진단 MUX"
      ],
      [
       "입력 범위",
       "VBATP 5.8–36 V (CAN·I/O·코어·센서 레일), 초기 기동 후 4.5–5.8 V까지 3.3 V I/O·코어 유지. 권장 최대 34 V"
      ],
      [
       "VDD6 벅",
       "6 V(5.4–6.6 V), 1.3 A, 내부 FET, f<sub>SW</sub> 440 kHz(396–484), 드롭아웃 0.6 V @1.3 A, 100 % 듀티 가능"
      ],
      [
       "VDD5 / VDD3/5",
       "각 300 mA LDO(전류 제한 350–650 mA). VDD5 = 4.9–5.1 V. VDD3/5 = 3.234–3.366 V(SEL_VDD3/5 개방) 또는 4.9–5.1 V(GND)"
      ],
      [
       "VDD1",
       "0.8–3.3 V 가변, 외부 N-FET 구동, 10–600 mA, 기준 0.8 V ±1 %(0.792–0.808 V)"
      ],
      [
       "VSOUT1",
       "3.3–9.5 V 가변 센서 전원, 100 mA(제한 120–500 mA), 트래킹 오차 ±35 mV, 비트래킹 기준 2.5 V; 배터리/접지 단락 보호"
      ],
      [
       "차지펌프",
       "VCP = VBATP + 4 V … VBATP + 15 V, 250 kHz"
      ],
      [
       "워치독",
       "트리거(개방/폐쇄 윈도) 모드 또는 질문-응답(Q&amp;A) 모드, 시스템 클럭 4 MHz(3.8–4.2)"
      ],
      [
       "대기 전류",
       "최대 75 µA (전 레귤레이터 OFF, IGN = CANWU = 0 V, 5.8–20 V, T<sub>J</sub> &lt; 85 °C)"
      ],
      [
       "등급 · 온도",
       "차량용 -Q1 (ESD 시험 AEC-Q100-002/-011 기준), T<sub>A</sub> −40…125 °C"
      ],
      [
       "패키지",
       "HTSSOP-32 PowerPAD (DAP), 11.00 × 6.20 mm"
      ]
     ]
    }
   ]
