     "dl": [
      [
       "기능",
       "외부 N-채널 MOSFET 구동 이상 다이오드 컨트롤러 (차지펌프 내장), 역전류 차단, 내장 VDS 클램프로 ISO 7637 과도에 입력 TVS 없이 대응 (제품 페이지 기재)"
      ],
      [
       "입력 전압",
       "3.2 V ~ 65 V (기동 3.9 V), 역전압 −33 V (제품 페이지). 전기 특성표 동작 VANODE 4–60 V"
      ],
      [
       "순방향 레귤레이션",
       "VAK 20 mV typ (13–29 mV), 완전 도통 54 mV typ"
      ],
      [
       "역전류 차단",
       "VAK −11 mV typ (−17 ~ −2 mV) 에서 차단, 응답 &lt; 0.75 µs (제품 페이지), 게이트 피크 싱크 2000 mA typ"
      ],
      [
       "클램프",
       "VCLAMP (CATHODE−ANODE) 34 ~ 43 V"
      ],
      [
       "전류 소비",
       "동작 80 µA typ (130 µA max), 셧다운 0.9 µA typ (1.5 µA max)"
      ],
      [
       "기타",
       "배터리 전압 모니터용 SW 단로 스위치 (19.5 Ω typ)"
      ],
      [
       "등급",
       "AEC-Q100 Grade 1 (TA −40 ~ 125 °C)"
      ],
      [
       "패키지",
       "SOT-23-THN 8핀 (DDF)"
      ]
     ]
    }
   ]
