   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "기능",
       "3상 BLDC 컨트롤러 + N-채널 MOSFET 프리드라이버, 홀 센서 정류 디코더 내장 (120° 배치), 동기 정류, 관통 방지"
      ],
      [
       "공급 전압 VBB",
       "5.5 ~ 50 V 동작 (파라미터 보증 7 ~ 45 V)"
      ],
      [
       "게이트 구동 전원",
       "VREG 12.10 ~ 13.75 V (VBB ≥ 7.4 V), 차지펌프 + 톱오프 차지펌프로 100 % 듀티 가능"
      ],
      [
       "전류 감지",
       "내장 전류 감지 증폭기, 게인 19 V/V typ"
      ],
      [
       "입출력",
       "RESET, COAST, MODE, PWM, DIR, BRAKE, ESF 입력 · TACHO, DIRO 출력 · 오픈드레인 고장 플래그 FF1/FF2 · 홀 센서용 5 V 공급"
      ],
      [
       "진단",
       "저전압, 과온, 홀 로직 고장, 지락·천락 단락, 권선 단락, 저부하 전류"
      ],
      [
       "온도",
       "G: TA −40 ~ 105 °C, TJ 150 °C"
      ],
      [
       "품질 등급",
       "AEC-Q100 등급 명시 없음 (ESD 시험만 AEC-Q100-002/011 방법 인용)"
      ],
      [
       "패키지",
       "48-리드 QFN 7×7 mm, 노출 패드 (EV) — AMT49413GEVATR (7인치 릴 1000개)"
      ]
     ]
    }
   ]
