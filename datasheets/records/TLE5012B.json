     "dl": [
      [
       "기능",
       "iGMR 기반 360° 절대 각도 센서, SSC(SPI 호환 양방향) + 보조 인터페이스 1개"
      ],
      [
       "파생형 (모두 PG-DSO-8)",
       "E1000 IIF(인크리멘탈) · E3005 HSM(홀 스위치 모드) · E5000 PWM(push-pull) · E5020 PWM(open-drain) · E9000 SPC"
      ],
      [
       "전원",
       "VDD 3.0 – 5.5 V (5.0 V typ), IDD 약 14–16 mA"
      ],
      [
       "분해능",
       "15-bit 절대 각도 (0.01°), 인터페이스상 16-bit sin/cos"
      ],
      [
       "각도 오차",
       "자동 보정 시 0.6° typ (25 °C, 30 mT), 수명·온도 전체 1.0° max / 보정 없이 1.9° (수명 포함)"
      ],
      [
       "갱신 주기",
       "필터 업데이트 42.7 / 85.3 / 170.6 µs (FIR_MD = 1/2/3)"
      ],
      [
       "SSC 속도",
       "8.0 Mbit/s (push-pull), 2.0 Mbit/s (open-drain, 1 kΩ 풀업)"
      ],
      [
       "온도",
       "TJ −40 – 150 °C (Automotive qualified)"
      ],
      [
       "ESD",
       "HBM ±4.0 kV, SDM ±0.5 kV"
      ]
     ]
    }
   ]
