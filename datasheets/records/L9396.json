   "h": "핵심 사양",
   "blocks": [
    {
     "dl": [
      [
       "기능",
       "섀시·안전(브레이크/EPS) ECU용 다중 전원 SBC, ISO 26262 ASIL-D 시스템 대응"
      ],
      [
       "배터리 입력",
       "VBATP 4.5 ~ 19 V (부스트 사용), 6 ~ 19 V (부스트 미사용)"
      ],
      [
       "부스트",
       "9 V, 300 mA, 2 MHz (크랭킹·Stop&amp;Start·약전지 대응, 외부 다이오드·인덕터)"
      ],
      [
       "벅 프리레귤레이터",
       "6.5 V 또는 7.2 V, 1 A, 465 kHz"
      ],
      [
       "LDO",
       "VCC5 5 V 250 mA (µC I/O·ADC) · VCC 3.3 V/5 V 선택 100 mA"
      ],
      [
       "VCORE",
       "0.8 ~ 5 V, 외부 FET 사용, 벅 모드 최대 1 A / 리니어 모드 최대 750 mA"
      ],
      [
       "감시·안전",
       "Q&amp;A + 윈도우 이중 워치독, 이중 기준 전압, 모든 레일 UV/OV, FSN·RESET·FAULT 출력, 10비트 ADC, 열 차단"
      ],
      [
       "기타",
       "4채널 WSS/트래킹 레귤레이터 인터페이스, 페일세이프·모터 펌프 하이사이드 프리드라이버, SPI, PWM GPO, IGN 웨이크업, 스펙트럼 확산"
      ],
      [
       "등급",
       "AEC-Q100, Ta −40 ~ 135 °C"
      ],
      [
       "패키지",
       "TQFP64EP (노출 패드 하면), 10 × 10 × 1 mm, 튜브 포장"
      ]
     ]
    }
   ]
